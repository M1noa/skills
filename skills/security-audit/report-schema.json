{
  "$comment": "contract for findings.json. checked by validate-findings.cjs.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "fingerprint": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+#-]*$" },
      "title": { "type": "string", "minLength": 1 },
      "description": { "type": "string", "minLength": 1 },
      "impact": { "type": "string", "minLength": 1 },
      "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFORMATIONAL"] },
      "privileges_required": { "type": "string", "enum": ["NONE", "LOW", "HIGH"] },
      "attacker_position": { "type": "string", "enum": ["EXTERNAL", "INTERNAL_NETWORK", "IN_CLUSTER", "LOCAL", "HOST_SYSTEM", "SUPPLY_CHAIN", "PHYSICAL_TEMPORARY", "PHYSICAL_LONG_TERM"] },
      "user_interaction": { "type": "string", "enum": ["NONE", "REQUIRED"] },
      "code_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^.+:[0-9]+$" } },
      "status": { "type": "string", "enum": ["VALID", "PROVISIONALLY_VALID", "FALSE_POSITIVE", "NEEDS_RESEARCH", "NEEDS_VALIDATION", "DUPLICATE"] },
      "duplicate_of": { "type": "string" },
      "production_viability": { "type": "string", "enum": ["VIABLE", "CONDITIONAL_VIABLE", "SAMPLE_OR_TEST", "NON_VIABLE"] },
      "repro_status": { "type": "string", "enum": ["reproduced", "failed_to_reproduce", "statically_confirmed", "not_attempted"] },
      "repro_file_path": { "type": "string" },
      "run_command": { "type": "string" },
      "repro_output": { "type": "string" },
      "patch_status": { "type": "string", "enum": ["VERIFIED_SECURE", "MITIGATION_PROPOSED", "VERIFICATION_INCOMPLETE", "VERIFICATION_FAILED", "ERROR"] },
      "patch_diff": { "type": "string" },
      "reattack_status": { "type": "string", "enum": ["bypassed_patch", "failed_to_bypass"] },
      "inferred_exposure": { "type": "string", "enum": ["EXPOSED", "INTERNAL", "PRIVILEGED"] },
      "tags": { "type": "array", "items": { "type": "string" } },
      "risk_score": { "type": "number", "minimum": 1, "maximum": 10 },
      "impact_score": { "type": "number", "minimum": 1, "maximum": 5 },
      "likelihood_score": { "type": "number", "minimum": 1, "maximum": 5 },
      "context_multiplier": { "type": "number", "minimum": 0.1, "maximum": 1.0 },
      "executive_summary": { "type": "string" },
      "mitigation": { "type": "string" },
      "constituent_findings": { "type": "array", "items": { "type": "string" } },
      "triage_checklist": { "type": "object" },
      "critic_reasoning": { "type": "string" },
      "blockers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
      "validation_plan": { "type": "object" },
      "history": { "type": "array" }
    },
    "required": ["id", "title", "description", "code_paths", "status"],
    "additionalProperties": true
  }
}
